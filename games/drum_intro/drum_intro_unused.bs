script drum_intro_unused_sub_08a21600
    beat_anim
    dmi_event01 258
    rest 6
    dmi_event01 64
    rest 6
    dmi_event01 1
    rest 6
    dmi_event01 16
    rest 6
    beat_anim
    dmi_event01 1
    rest 6
    dmi_event01 544
    rest 6
    dmi_event01 0
    rest 6
    dmi_event01 544
    rest 6
    beat_anim
    dmi_event01 0
    rest 5
    dmi_event01 2
    rest 3
    dmi_event01 128
    rest 4
    dmi_event01 2
    rest 6
    dmi_event01 32
    rest 6
    beat_anim
    dmi_event01 1
    rest 6
    dmi_event01 0
    rest 6
    dmi_event01 1
    rest 6
    dmi_event01 16
    rest 6
    beat_anim
    dmi_event01 258
//    #ifdef PLUS
