return


script script_drum_intro_unused_main
    enable_pause_menu
    set_tempo 120
    set_music_volume 0
    mod_music_volume 256, 192
    #ifdef PLUS
    play_music s_dr_sam_bgm_seqData
    #endif
    rest 24
    rest 24
    rest 24
    dmi_event02 1
    rest 24
    dmi_event02 2
    print_text_s D_0805d438
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
    dmi_event02 2
    print_text_s D_0805d458
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
    dmi_event02 2
    print_text_s D_0805d4b4
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
    dmi_event02 2
    print_text_s D_0805d508
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
    #ifdef PLUS
    mod_music_volume 0, 48
    #else
    mod_music_volume 0, 96
    #endif
    dmi_event02 2
    print_text_s D_0805d554
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
    dmi_event02 0
    rest 48
    set_tempo 130
    call drum_intro_unused_sub_08a21390
    call drum_intro_unused_sub_08a213fc
    call drum_intro_unused_sub_08a213fc
    call drum_intro_unused_sub_08a214ec
    call drum_intro_unused_sub_08a21600
    rest 24
    set_game_fade_in_time 8

    load_drum_intro_play
    rest 24
    dmi_event04 TRUE
    dmi_event03 2
    print_text_s D_0805d568
    rest 48
    dmi_event03 1
    clear_text_s
    no_op
    call drum_intro_unused_sub_08a213d8
    rest_beats 4
    rest_beats 4
    rest_beats 4
    dmi_event04 FALSE
//    #ifdef PLUS 
//    mod_music_volume 0, 32
//    #endif
    rest_beats 4
    set_tempo 120
    dmi_event03 2
    print_text_s D_0805d57c
    rest_beats 5
    dmi_event03 1
    clear_text_s
    no_op
    rest 24
    set_game_fade_in_time 8

    load_drum_intro_talk
    dmi_event02 1
    mod_music_volume 256, 192
    #ifdef PLUS
    play_music s_dr_sam_bgm_seqData
    #endif
    rest 48
    dmi_event02 2
    print_text_s D_0805d5a4
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
    dmi_event02 2
    print_text_s D_0805d5ec
    run gameplay_display_text_and_wait
    dmi_event02 1
    rest 12
return

.end
