.include "include/beatscript.inc"
.include "games/drum_intro/macros.inc"



.section .script.entry
@ Drum Intro (Unused) - Script Entry Point

script script_drum_intro_unused_entry
    set_tempo 124
    rest 24
    rest 24
    load_drum_intro_talk
    enable_play_inputs
    start_tracking_inputs
    call script_drum_intro_unused_main
    disable_pause_menu
    disable_play_inputs
    fade_music_out 48
    fade_screen_out 12, BLACK
    rest 24
    rest 24
stop

define_gameplay_scene scene_drum_intro_unused, script_drum_intro_unused_entry



.section .script.main
@ Drum Intro (Unused) - Main Script

script drum_intro_unused_sub_08a21294
    play_sfx_localized s_intro_one_seqData, s_intro_one_en_seqData
    beat_anim
    rest 24
    rest 24
    play_sfx_localized s_intro_two_seqData, s_intro_two_en_seqData
    beat_anim
    rest 24
    rest 12
    play_sfx_localized s_intro_a_seqData, s_intro_a_en_seqData
    rest 12
    play_sfx_localized s_intro_one_seqData, s_intro_one_en_seqData
    beat_anim
    rest 24
    play_sfx_localized s_intro_two_seqData, s_intro_two_en_seqData
    beat_anim
    rest 24
    play_sfx_localized s_intro_three_seqData, s_intro_three_en_seqData
    beat_anim
    rest 12
    #ifdef PLUS
    rest_localized 0, 12
    play_sfx_localized s_intro_four_seqData, s_intro_go_en_seqData
    #endif
return


script drum_intro_unused_sub_08a21390
    call drum_intro_unused_sub_08a21294
    #ifdef PLUS
    #else
    rest_localized 0, 12
    play_sfx_localized s_intro_four_seqData, s_intro_go_en_seqData
    #endif
    rest_localized 12, 0
    beat_anim
    rest 24
// Commented out code is for a music function so that the game can play music while you drum.
// Judging by Drum intro 3, this isn't the original intended functionality, though. 
// I've chosen to leave this in the code if anyone wants to use it.
//    #ifdef PLUS 
//    set_music_volume 156
//    play_music s_drum_lesson_bgm_seqData
//    #endif
return


script drum_intro_unused_sub_08a213d8
    call drum_intro_unused_sub_08a21294
//    #ifdef PLUS
//    rest 12
//    beat_anim
//    rest 24
//    set_music_volume 156
//    play_music s_drum_lesson_bgm_seqData
//    set_music_volume 156
//    play_music s_drum_lesson_bgm_seqData
//    #else
    rest_localized 12, 0
    #ifdef PLUS
    beat_anim
    #endif
    rest 16
return


script drum_intro_unused_sub_08a213fc
    beat_anim
    dmi_event01 2
    rest 24
    beat_anim
    dmi_event01 16
    rest 24
    beat_anim
    dmi_event01 2
    rest 12
    dmi_event01 2
    rest 12
    beat_anim
    dmi_event01 16
    rest 24
return


script drum_intro_unused_sub_08a214ec
    beat_anim
    dmi_event01 2
    rest 24
    beat_anim
    dmi_event01 16
    rest 24
    beat_anim
    dmi_event01 2
    rest 12
    dmi_event01 2
    rest 12
    beat_anim
    dmi_event01 16
    rest 12
    dmi_event01 65
    rest 12
